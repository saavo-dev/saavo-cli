# Local development configuration. Copy this file to .env.
# OAuth 2.0 public-client registration (public value, not a secret).
SAAVO_OAUTH_CLIENT_ID=

# Authorization server configuration
SAAVO_OAUTH_ISSUER=https://saavo.dev
SAAVO_OAUTH_AUTHORIZATION_ENDPOINT=https://saavo.dev/oauth/authorize
SAAVO_OAUTH_TOKEN_ENDPOINT=https://saavo.dev/oauth/token
SAAVO_OAUTH_SCOPE="user templates:read"
SAAVO_CURRENT_USER_ENDPOINT=https://saavo.dev/oauth/current-user
SAAVO_TEMPLATES_ENDPOINT=https://saavo.dev/api/templates

# Local development only. Allows HTTP OAuth endpoints on loopback hosts.
SAAVO_OAUTH_ALLOW_INSECURE=false

# Directory used to store credentials.json and last-error.json. Leave empty to use ~/.saavo.
SAAVO_CONFIG_DIR=
