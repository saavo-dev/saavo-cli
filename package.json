{
  "name": "saavo-cli",
  "version": "0.1.1",
  "description": "Official CLI for creating and managing Saavo projects",
  "type": "module",
  "bin": {
    "saavo": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "saavo",
    "cli",
    "scaffolding",
    "cloudflare",
    "oauth",
    "typescript",
    "saas"
  ],
  "homepage": "https://saavo.dev",
  "bugs": {
    "url": "https://github.com/saavo-dev/saavo-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saavo-dev/saavo-cli.git"
  },
  "author": "Saavo",
  "scripts": {
    "build": "vite build",
    "build:production": "vite build --mode production",
    "dev": "vite-node --mode development src/index.ts",
    "test": "vitest run --dir test",
    "test:watch": "vitest --dir test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm test && npm run typecheck",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "prepack": "npm run verify && npm run build:production && npm run smoke:dist && npm run smoke:package"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "oauth4webapi": "^3.8.6",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
