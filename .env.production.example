# Copy this file to .env.production before running `npm run build:production`.
# These values are embedded into dist/oauth/build-config.json.

SAAVO_OAUTH_CLIENT_ID=
SAAVO_OAUTH_ISSUER=https://saavo.dev
SAAVO_OAUTH_AUTHORIZATION_ENDPOINT=https://saavo.dev/oauth/authorize
SAAVO_OAUTH_TOKEN_ENDPOINT=https://saavo.dev/oauth/token
SAAVO_OAUTH_SCOPE="user templates:read"
SAAVO_CURRENT_USER_ENDPOINT=https://saavo.dev/oauth/current-user
SAAVO_TEMPLATES_ENDPOINT=https://saavo.dev/api/templates
